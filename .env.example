# Copy this file to .env and fill in real values. Never commit .env.

# Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-telegram-bot-token

# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-replace-with-your-gemini-api-key

# Optional: override the vision model (defaults to gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# Optional: model used when the primary one is overloaded (503/429). Empty disables fallback.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: reasoning depth (minimal, low, medium, high). minimal is fastest, low is the default.
# GEMINI_THINKING_LEVEL=low

# Optional: output token budget. Thinking tokens count against it; keep it large.
# GEMINI_MAX_OUTPUT_TOKENS=32768

# Optional: HTTPS URL of the Mini App (webapp/ on Vercel). When set, every result
# gets an "Open 3D viewer" button. Leave empty to send JSON only.
# WEBAPP_URL=https://your-app.vercel.app
