# Server-side only (never exposed to the browser). Copy to .env.local for `npm run dev`;
# on Vercel add the same names under Project -> Settings -> Environment Variables.

# Required for the "O'zgartirish" (change request) bar: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-replace-with-your-gemini-api-key

# Optional, same defaults as bot.py
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=low
# GEMINI_MAX_OUTPUT_TOKENS=32768
